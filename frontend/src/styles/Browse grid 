/* ============================================
   เพิ่มต่อท้าย theme.css — layout หน้าสินค้าทั้งหมด ตรงกับ mockup
   ============================================ */

.browse-grid{
  display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
  padding:44px 32px;
}
.browse-card{
  background:#fff; border:1px solid var(--line); border-radius:16px;
  padding:14px; cursor:pointer;
}
.browse-card .bimg{
  height:150px; border-radius:10px; background:var(--parchment-deep);
  margin-bottom:10px; overflow:hidden;
}

/* บนมือถือ ลดเหลือ 2 คอลัมน์ */
@media (max-width: 768px) {
  .browse-grid{
    grid-template-columns:repeat(2,1fr);
    padding:24px 18px;
    gap:14px;
  }
}