# ตัวอย่างไฟล์ตั้งค่า — คัดลอกเป็น application.properties แล้วเติมค่าจริง
# ไฟล์นี้อยู่ใน git จึงห้ามใส่ค่าลับใดๆ ลงไป ให้ทิ้งเป็นค่าว่างเสมอ

spring.application.name=smartsell-ai

# ---- PostgreSQL ----
spring.datasource.url=jdbc:postgresql://localhost:5432/smartsell
spring.datasource.username=CHANGE_ME
spring.datasource.password=

# let Hibernate create/update tables from the entities below while you're prototyping
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ---- JWT ----
# สร้างค่าใหม่ด้วย: openssl rand -base64 64
# ต้องยาวอย่างน้อย 32 ไบต์ ไม่งั้นแอปจะไม่ยอมสตาร์ท (ดู JwtUtil.validateSecret)
app.jwt.secret=
app.jwt.expiration-ms=86400000

# ---- Auth ----
# รหัสเชิญที่ต้องใช้ตอนสมัครและตอนรีเซ็ตรหัสผ่าน ตั้งผ่าน env ได้: APP_AUTH_INVITE_CODE
# สร้างค่าใหม่ด้วย: openssl rand -base64 24
# ถ้าเว้นว่าง จะไม่มีใครสมัครหรือรีเซ็ตรหัสได้เลย
app.auth.invite-code=

# บัญชีเริ่มต้นที่สร้างตอนสตาร์ทครั้งแรก ตั้งผ่าน env ได้: APP_SEED_ADMIN_EMAIL / APP_SEED_ADMIN_PASSWORD
# ถ้าเว้นว่างตัวใดตัวหนึ่ง จะข้ามการสร้างบัญชี (รหัสผ่านต้องยาวอย่างน้อย 8 ตัว)
app.seed.admin-email=
app.seed.admin-password=

# ---- LLM API (Gemini) ----
# ขอ key ที่ https://aistudio.google.com/apikey
app.ai.gemini-api-key=

server.port=8080

# ---- Mail (Gmail SMTP) ----
# password ต้องเป็น App Password ของ Google (ต้องเปิด 2-Step Verification ก่อน)
# สร้างที่ https://myaccount.google.com/apppasswords — ใช้รหัสผ่าน Gmail ปกติไม่ได้
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.username=
spring.mail.password=
